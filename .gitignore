# Local-only override files (e.g. .claude/settings.local.json) — never committed.
*.local.json

# Local course-build source material (member packs, scorecards, maps dropped in to build
# a Play course) and scratch working files — never committed.
*.pdf
scripts/play/g_*.png
scripts/play/gailes_*.png
scripts/play/gailes_*.json
scripts/play/gailes_place.mjs
# trace-tool working files (re-exported as you hand-trace; rebuilt via from-traced.mjs)
scripts/play/*.traced.json
scripts/play/*.traced_built.json
_tooltest/
scripts/play/_osm/*_built.json
